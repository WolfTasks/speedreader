{
  "manifest_version": 3,
  "name": "SpeedReader",
  "version": "0.2.0",
  "description": "Lese Texte schneller mit der RSVP-Methode",
  "minimum_chrome_version": "121",
  "browser_specific_settings": {
    "gecko": {
      "id": "speedreader@wolftasks.github.io",
      "strict_min_version": "121.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "commands": {
    "read-selection": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Markierten Text mit SpeedReader lesen"
    }
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "SpeedReader",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
